*.pt
*.onnx
*.tflite

# LaTeX build files
docs/*.aux
docs/*.log
docs/*.out
docs/*.toc
docs/*.lof
docs/*.lot
docs/*.fls
docs/*.fdb_latexmk
docs/*.synctex.gz
