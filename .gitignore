# environments and caches
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/

# data and generated results (never commit personal images or video)
input/
output/
*.wav

# model weights (download with scripts/setup_ubuntu.sh or let Ultralytics fetch them)
models/*
